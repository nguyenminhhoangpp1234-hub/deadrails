local function makeActionButton(text, callback)
    local button = makeButton(page, text, UDim2.new(1, -4, 0, 34), UDim2.new(0, 0, 0, 0))
    button.Activated:Connect(callback)
    return button
end

local function makeToggle(labelText, key)
    local button
    local function refresh()
        button.Text = labelText .. ": " .. (state.toggles[key] and "BẬT" or "TẮT")
        button.BackgroundColor3 = state.toggles[key]
            and Color3.fromRGB(45, 104, 77) or Color3.fromRGB(48, 54, 68)
    end
    button = makeActionButton(labelText .. ": TẮT", function()
        state.toggles[key] = not state.toggles[key]
        refresh()
    end)
    refresh()
    return button
end

local function makeItemRow(itemName, isESP)
    local collection = isESP and state.espItems or state.selectedItems
    local button
    local function refresh()
        button.Text = (collection[itemName] and "☑  " or "□  ") .. itemName
        button.BackgroundColor3 = collection[itemName]
            and Color3.fromRGB(45, 90, 72) or Color3.fromRGB(38, 43, 54)
    end
    button = makeButton(page, itemName, UDim2.new(1, -4, 0, 31), UDim2.new(0, 0, 0, 0))
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Activated:Connect(function()
        collection[itemName] = not collection[itemName]
        refresh()
    end)
    refresh()
end

local function renderItems(isESP)

    clearPage()
    local collection = isESP and state.espItems or state.selectedItems
    makeLabel(isESP and "Chọn món muốn đánh dấu ESP" or "Chọn vật phẩm cần ưu tiên", 32)
    makeActionButton("Chọn tất cả", function()
        for _, name in ipairs(ITEMS) do collection[name] = true end
        renderItems(isESP)
    end)
    makeActionButton("Bỏ chọn tất cả", function()
        for _, name in ipairs(ITEMS) do collection[name] = false end
        renderItems(isESP)
    end)
    for _, name in ipairs(ITEMS) do
        makeItemRow(name, isESP):SetAttribute("ItemRow", true)
    end
end

