            renderTab("Cài đặt")
        end)
        makeActionButton("Xóa lựa chọn vật phẩm", function()
            state.selectedItems = {}
            renderTab("Cài đặt")
        end)
        makeActionButton("Đặt lại trạng thái các công tắc", function()
            for key in pairs(state.toggles) do state.toggles[key] = false end
            renderTab("Cài đặt")
        end)
        makeLabel("Đóng menu sẽ xóa GUI và các kết nối thuộc giao diện.", 42)
    end
end

