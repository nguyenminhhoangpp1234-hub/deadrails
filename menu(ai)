local function makeLabel(text, height)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -4, 0, height or 32)
    label.BackgroundColor3 = Color3.fromRGB(38, 43, 54)
    label.BorderSizePixel = 0
    label.Font = Enum.Font.Gotham
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 224, 234)
    label.TextSize = 13
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = page
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 7)
    local padding = Instance.new("UIPadding")
    padding.PaddingLeft = UDim.new(0, 9)
    padding.PaddingRight = UDim.new(0, 9)
    padding.Parent = label
    return label
end

local function makeActionButton(text, callback)
    local button = makeButton(page, text, UDim2.new(1, -4, 0, 34), UDim2.new(0, 0, 0, 0))
    button.Activated:Connect(callback)
    return button
end

local function makeToggle(labelText, key)
    local button
    local function refresh()
        button.Text = labelText .. ": " .. (state.toggles[key] and "BẬT" or "TẮT")
        button.BackgroundColor3 = state.toggles[key]
            and Color3.fromRGB(45, 104, 77) or Color3.fromRGB(48, 54, 68)
    end
    button = makeActionButton(labelText .. ": TẮT", function()
        state.toggles[key] = not state.toggles[key]
        refresh()
    end)
    refresh()
    return button
end

local function makeSearchBox(placeholder, initial, onChanged)
    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -4, 0, 34)
    box.BackgroundColor3 = Color3.fromRGB(38, 43, 54)
    box.BorderSizePixel = 0
    box.Font = Enum.Font.Gotham
    box.PlaceholderText = placeholder
    box.Text = initial or ""
    box.TextColor3 = Color3.fromRGB(240, 242, 248)
    box.PlaceholderColor3 = Color3.fromRGB(150, 156, 170)
    box.TextSize = 13
    box.ClearTextOnFocus = false
    box.Parent = page
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 7)
    box:GetPropertyChangedSignal("Text"):Connect(function()
        onChanged(box.Text)
    end)
    return box
end

local function makeItemRow(itemName, isESP)
    local collection = isESP and state.espItems or state.selectedItems
    local button
    local function refresh()
        button.Text = (collection[itemName] and "☑  " or "□  ") .. itemName
        button.BackgroundColor3 = collection[itemName]
            and Color3.fromRGB(45, 90, 72) or Color3.fromRGB(38, 43, 54)
    end
    button = makeButton(page, itemName, UDim2.new(1, -4, 0, 31), UDim2.new(0, 0, 0, 0))
    button.TextXAlignment = Enum.TextXAlignment.Left
    button.Activated:Connect(function()
        collection[itemName] = not collection[itemName]
        refresh()
    end)
    refresh()
end

local function renderItems(isESP)
    clearPage()
    local collection = isESP and state.espItems or state.selectedItems
    makeLabel(isESP and "Chọn món muốn đánh dấu ESP" or "Chọn vật phẩm cần ưu tiên", 32)
    makeSearchBox("Tìm vật phẩm...", state.searchText, function(value)
        state.searchText = value
        -- Rebuild only the rows, not the search box, to avoid losing keyboard focus.
        for _, child in ipairs(page:GetChildren()) do
            if child:GetAttribute("ItemRow") then child:Destroy() end
        end
        local query = string.lower(value)
        for _, name in ipairs(ITEMS) do
            if query == "" or string.find(string.lower(name), query, 1, true) then
                makeItemRow(name, isESP):SetAttribute("ItemRow", true)
            end
        end
    end)
    makeActionButton("Chọn tất cả", function()
        for _, name in ipairs(ITEMS) do
            if state.searchText == "" or string.find(string.lower(name), string.lower(state.searchText), 1, true) then
                collection[name] = true
            end
        end
        renderItems(isESP)
    end)
    makeActionButton("Bỏ chọn tất cả", function()
        for _, name in ipairs(ITEMS) do collection[name] = false end
        renderItems(isESP)
    end)
    local query = string.lower(state.searchText)
    for _, name in ipairs(ITEMS) do
        if query == "" or string.find(string.lower(name), query, 1, true) then
            makeItemRow(name, isESP):SetAttribute("ItemRow", true)
        end
    end
end

local function renderTab(tabName)
    state.activeTab = tabName
    contentTitle.Text = tabName
    clearPage()

    if tabName == "Tổng quan" then
        makeLabel("Dead Rails Ultimate Hub • Android", 32)
        makeLabel("Đây là giao diện cấu hình. Các nút chưa tự can thiệp vào cơ chế máy chủ của game.", 48)
        makeLabel("Chọn tab bên phải để mở chức năng.", 32)
        makeLabel("Lựa chọn ESP: " .. tostring((function()
            local n = 0
            for _, value in pairs(state.espItems) do if value then n = n + 1 end end
            return n
        end)()) .. " món", 30)
        makeLabel("Vật phẩm ưu tiên: " .. tostring((function()
            local n = 0
            for _, value in pairs(state.selectedItems) do if value then n = n + 1 end end
            return n
        end)()) .. " món", 30)

    elseif tabName == "Auto Loot" then
        makeToggle("Auto Loot (cấu hình)", "autoLoot")
        makeLabel("Chưa kết nối cơ chế nhặt đồ thật; cần xác minh cách game hỗ trợ nhặt vật phẩm.", 48)
        makeActionButton("Mở danh sách vật phẩm", function() renderTab("Danh sách item") end)

    elseif tabName == "Danh sách item" then
        renderItems(false)

    elseif tabName == "ESP vật phẩm" then
        makeToggle("ESP tổng (cấu hình)", "esp")
        makeLabel("Danh sách dưới đây lưu lựa chọn ESP. Việc vẽ nhãn thật cần nhận diện vật phẩm hợp lệ.", 48)
        -- renderItems clears page, so add the general toggle again inside its page.
        renderItems(true)

    elseif tabName == "Auto Climb" then
        makeToggle("Auto Climb (cấu hình)", "autoClimb")
        makeLabel("Chưa điều khiển nhân vật tự động. Cần cơ chế leo hợp lệ và kiểm tra vật cản.", 48)

    elseif tabName == "Zombie Mode" then
        makeToggle("Zombie Mode (cấu hình)", "zombieMode")
        makeLabel("Giao diện trạng thái né zombie; chưa dò hay điều khiển NPC trong game.", 48)

    elseif tabName == "Zombie Freeze" then
        makeToggle("Zombie Freeze (cấu hình)", "zombieFreeze")
        makeLabel("Chỉ là công tắc cấu hình. Không đóng băng NPC hoặc thay đổi vật lý nhân vật từ client.", 48)

    elseif tabName == "Aura Kill" then
        makeToggle("Aura Kill (cấu hình)", "auraKill")
        makeLabel("Chưa gửi sát thương. Chỉ triển khai trong trải nghiệm mày sở hữu/được phép sửa và qua cơ chế chiến đấu hợp lệ.", 60)

    elseif tabName == "Zombie Head Lock" then
        makeToggle("Zombie Head Lock (cấu hình)", "headLock")
        makeLabel("Chưa khóa camera hay tự ngắm. Nhận diện mục tiêu cần xác minh và phải tránh khóa nhầm người chơi.", 52)

    elseif tabName == "Auto Attack" then
        makeToggle("Auto Attack (cấu hình)", "autoAttack")
        makeLabel("Chọn mức mong muốn. Đây chỉ là lựa chọn UI, không tăng tốc đánh thật.", 38)
        for _, rate in ipairs({30, 40, 50}) do
            local button = makeActionButton("Tốc độ đánh " .. rate .. (state.attackRate == rate and "  ✓" or ""), function()
                state.attackRate = rate
                renderTab("Auto Attack")
            end)
            if state.attackRate == rate then button.BackgroundColor3 = Color3.fromRGB(45, 90, 72) end
        end
        makeLabel("Mức đang chọn: " .. state.attackRate, 30)

    elseif tabName == "Auto Heal" then
        makeToggle("Auto Heal bằng Snake Oil (cấu hình)", "autoHeal")
        makeLabel("Ngưỡng máu: " .. state.healThreshold .. "%", 30)
        for _, threshold in ipairs({20, 30, 40, 50, 60}) do
            local button = makeActionButton("Hồi khi máu dưới " .. threshold .. "%" .. (state.healThreshold == threshold and "  ✓" or ""), function()
                state.healThreshold = threshold
                renderTab("Auto Heal")
            end)
            if state.healThreshold == threshold then button.BackgroundColor3 = Color3.fromRGB(45, 90, 72) end
        end
        makeLabel("Snake Oil chưa được tự sử dụng. Cần xác minh cách dùng vật phẩm và lượng máu trong game.", 52)

    elseif tabName == "Cài đặt" then
        makeLabel("Chống lỗi giao diện", 30)
        makeActionButton("Xóa lựa chọn ESP", function()
            state.espItems = {}
            renderTab("Cài đặt")
        end)
        makeActionButton("Xóa lựa chọn vật phẩm", function()
            state.selectedItems = {}
            renderTab("Cài đặt")
        end)
        makeActionButton("Đặt lại trạng thái các công tắc", function()
            for key in pairs(state.toggles) do state.toggles[key] = false end
            renderTab("Cài đặt")
        end)
        makeLabel("Đóng menu sẽ xóa GUI và các kết nối thuộc giao diện.", 42)
    end
end

